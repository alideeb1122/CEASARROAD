","closedDay":"Closed","rights":"© 2025 Caesar Road Travel & Tourism. All rights reserved.","socials":[{"type":"instagram","url":"https://www.instagram.com/caesar_road_travel?igsh=MWxwbjBneWRlMzk5dA==","label":"Instagram"},{"type":"facebook","url":"https://www.facebook.com/Caesarroad22?mibextid=ZbWKwL","label":"Facebook"},{"type":"youtube","url":"https://youtube.com/@Caesar.road.travel?si=prhqNMC4RHN1rN_f","label":"YouTube"},{"type":"tiktok","url":"https://www.tiktok.com/@caesar.road2","label":"TikTok"},{"type":"linkedin","url":"https://www.linkedin.com/company/caesar-road-travel-and-tourism/","label":"LinkedIn"}]}}]]}]}]]}],{"children":["en",["$","$1","c",{"children":[null,["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":["__PAGE__",["$","$1","c",{"children":[["$","$L6",null,{"kicker":"CAESAR ROAD","title":"Caesar Road","children":["$","div",null,{"className":"luxury-home","children":[["$","$L7",null,{}],["$","$L8",null,{"content":{"heroLabel":"Caesar Road Travel & Tourism","heroTitle":"Refined Travel Starts Here","heroTitleAccent":"Caesar Road arranges your journey beautifully","heroSubtitle":"","heroWhatsappCta":"Chat on WhatsApp","heroServicesCta":"Explore Services","heroMediaLabel":""},"locale":"en","servicesHref":"/en/services","whatsappNumber":"971501234567","statsLabel":"By the Numbers","statsTitle":"Our Achievements Speak for Us","stats":[{"value":10,"suffix":"+","label":"Years of Experience"},{"value":3,"suffix":"","label":"Active Branches"},{"value":10000,"suffix":"+","label":"Happy Clients"},{"value":50,"suffix":"+","label":"Destinations Worldwide"}]}],["$","$L9",null,{"label":"Why Us","title":"Why Choose Caesar Road?","subtitle":"We combine experience and trust to deliver an exceptional, unforgettable travel experience","points":[{"icon":"check","title":"Years of Experience","desc":"Over a decade in the travel industry gives us unmatched knowledge and expertise"},{"icon":"globe","title":"Worldwide Destinations","desc":"An extensive partner network covering more than 50 global tourism destinations"},{"icon":"headset","title":"24/7 Support","desc":"Our team is always available to serve you and answer your inquiries whenever you need us"},{"icon":"star","title":"Competitive Pricing","desc":"We guarantee the best prices and highest quality with absolutely no compromise"}]}],["$","$La",null,{"label":"What We Offer","title":"Everything for a Perfect Journey","subtitle":"A complete suite of travel services designed to make every trip smooth from the very first moment","locale":"en","variant":"compact","items":[{"title":"Visas & Residency","subtitle":"This service is structured to help clients understand available destinations quickly, review the right documents early, and move forward with fewer questions and less friction.","href":"/en/services/visa-residency","eyebrow":"Structured service","cta":"View destinations","icon":"passport","highlights":["Clear destination-based structure","Focused details for each process","Direct follow-up to keep requests moving"],"image":"https://images.pexels.com/photos/33497885/pexels-photo-33497885.jpeg?auto=compress&cs=tinysrgb&w=1600","imageAlt":"Passports and travel documents arranged on a table for visa and residency services","imagePosition":"center center"},{"title":"Flight Bookings","subtitle":"We turn booking into a structured service flow: destinations, booking types, then the operational details that help the client choose the best route quickly.","href":"/en/services/flight-booking","eyebrow":"Travel options","cta":"View options","icon":"plane","highlights":["Cleaner comparison across booking options","Direct follow-up until confirmation","Messaging built around speed and clarity"],"image":"/images/hero/flight-booking-hero.jpg","imageAlt":"Modern aircraft representing organized and confirmed flight bookings","imagePosition":"center center"},{"title":"Group Tours","subtitle":"We turn the trip into a clear program, from destination choice to booking details and follow-up.","href":"/en/services/study-abroad","eyebrow":"Organized trips","cta":"View trips","icon":"globe","highlights":["Ready-made and easy-to-read programs","Smoother planning for groups and families","A stronger sense of the real trip experience"],"image":"https://images.pexels.com/photos/36729289/pexels-photo-36729289.jpeg?auto=compress&cs=tinysrgb&w=1600","imageAlt":"Travel group planning a city tour outdoors","imagePosition":"center center"},{"title":"Language Exam Bookings","subtitle":"Instead of presenting exams as flat repetitive entries, we give each test its own page with clearer requirements, booking logic, and follow-up support.","href":"/en/services/language-exams","eyebrow":"Direct structure","cta":"View options","icon":"star","highlights":["Focused pages for each exam","Practical pre-booking information","Structure ready for future centers and dates"],"image":"/images/hero/goethe-exam.jpg","imageAlt":"Language exam preparation materials and academic certificate","imagePosition":"center center"},{"title":"Other Services","subtitle":"If you need help arranging a passport appointment, we guide you to the right service and help organize the process from the start.","href":"/en/services/other-services","eyebrow":"Support services","cta":"View services","icon":"shield","highlights":["Clearer appointment flow","Direct booking and follow-up support","Internal and external options based on your case"],"image":"https://images.pexels.com/photos/32060712/pexels-photo-32060712.jpeg?auto=compress&cs=tinysrgb&w=1600","imageAlt":"Passports and travel documents arranged for passport booking services","imagePosition":"center center"}]}],["$","$Lb",null,{"label":"Airline Partners","trust":"We book through the region's and world's leading airlines","locale":"en"}],["$","$Lc",null,{"locale":"en"}],["$","$Ld",null,{"label":"Our Branches","title":"We Are Close to You","subtitle":"Three branches serving you at the heart of each city — always within reach","branches":[{"city":"Dubai","country":"United Arab Emirates","address":"Al Barsha 1 – Al Bidaya Building – Office 302","mapUrl":"https://maps.app.goo.gl/NzAPJUiPULQs8YUz8","whatsapp":"971529015091","hours":"10:00 AM – 6:00 PM","offDay":"Sunday","description":"Our Dubai branch in Al Barsha serves you with the full range of professional travel and tourism services at the heart of the city."},{"city":"Erbil","country":"Iraq — Kurdistan Region","address":"Bakhtiary – Street 20 – opposite Qassab Erbil","mapUrl":"https://maps.app.goo.gl/v9wdBeigiUvSf4gbA","whatsapp":"9647509548130","hours":"10:00 AM – 8:00 PM","offDay":"Friday","description":"Our Erbil branch in Bakhtiary brings comprehensive travel services to the Kurdistan Region and all of Iraq with a well-established local presence."},{"city":"Homs","country":"Syria","address":"Western Corniche – beside Al-Dablan Garden – opposite Khairi Allah Broasted","mapUrl":"https://maps.app.goo.gl/oyDdPQpz9wQf2BMG7","whatsapp":"963960641418","hours":"8:00 AM – 4:00 PM","offDay":"Friday","description":"Our founding branch in Homs on the Western Corniche — serving our community with the professionalism and care that years of experience bring."}],"branchCta":"Contact Branch","mapCta":"View on Map","hoursLabel":"Working Hours","branchSocials":[{"platform":"Instagram","handle":"@caesar_road_travel","url":"https://www.instagram.com/caesar_road_travel?igsh=MWxwbjBneWRlMzk5dA==","type":"instagram","branch":"Homs"},{"platform":"Instagram","handle":"@caesar_road_uae","url":"https://www.instagram.com/caesar_road_uae?igsh=cmFndmQ1MDEyMjli","type":"instagram","branch":"Dubai"},{"platform":"Instagram","handle":"@caesar_road_erbil","url":"https://www.instagram.com/caesar_road_erbil?igsh=d2t1YzhxdjlxaHdu","type":"insta